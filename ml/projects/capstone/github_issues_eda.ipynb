    "def hyperparameter_tuning(X_train, y_train, best_model_name, models_results):\n",
    "    \"\"\"Perform hyperparameter tuning on the best model\"\"\"\n",
    "\n",
    "    print(f\"⚙️Tuning hyperparameters for: {best_model_name}\")\n",
    "\n",
    "    if best_model_name == 'Random Forest':\n",
    "        # Define parameter grids for Random Forest Regressor\n",
    "        param_grid = {\n",
    "            'model__n_estimators': [100, 200, 300],\n",
    "            'model__max_depth': [3, 5, 7, 10, None],\n",
    "            'model__min_samples_split': [2, 5, 10],\n",
    "            'model__min_samples_leaf': [1, 2, 4],\n",
    "            'model__max_features': ['sqrt', 'log2', None]\n",
    "        }\n",
    "\n",
    "        # Use RandomizedSearchCV for efficiency\n",
    "        search = RandomizedSearchCV(\n",
    "            models_results[best_model_name]['pipeline'],\n",
    "            param_grid,\n",
    "            n_iter=50,\n",
    "            cv=5,\n",
    "            scoring='neg_mean_squared_error',  # Changed from roc_auc\n",
    "            random_state=42,\n",
