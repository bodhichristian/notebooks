    "            'model__n_neighbors': [3, 5, 7, 9, 11, 15],\n",
    "            'model__weights': ['uniform', 'distance'],\n",
    "            'model__metric': ['euclidean', 'manhattan', 'minkowski']\n",
    "        }\n",
    "\n",
    "        search = GridSearchCV(\n",
    "            models_results[best_model_name]['pipeline'],\n",
    "            param_grid,\n",
    "            cv=5,\n",
    "            scoring='neg_mean_squared_error',  # Changed from roc_auc\n",
    "            n_jobs=-1\n",
    "        )\n",
    "\n",
    "    if best_model_name != 'Linear Regression':\n",
    "        print(\"🔄 Performing hyperparameter search...\")\n",
    "        search.fit(X_train, y_train)\n",
    "\n",
    "        print(f\"✅ Best CV score (neg MSE): {search.best_score_:.4f}\")\n",
    "        print(f\"✅ Best CV RMSE: {np.sqrt(-search.best_score_):.4f}\")\n",
    "        print(f\"🎯 Best parameters: {search.best_params_}\")\n",
    "\n",
    "        return search.best_estimator_, search\n",
    "\n",
    "    # This should never be reached due to early return above, but keeping for safety\n",
    "    return models_results[best_model_name]['pipeline'], None"
   ],
