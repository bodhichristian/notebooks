  {
   "metadata": {},
   "cell_type": "markdown",
   "source": "### Convert date columns to datetime",
   "id": "3b6501866026aaca"
  },
  {
   "metadata": {
    "ExecuteTime": {
     "end_time": "2025-08-15T12:52:25.435932Z",
