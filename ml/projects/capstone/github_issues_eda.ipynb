    "def prepare_features(data_frame):\n",
    "    \"\"\"Prepare features for modeling\"\"\"\n",
    "\n",
    "    # Create a copy to avoid modifying original data\n",
    "    df_processed = data_frame.copy()\n",
    "\n",
    "    # Create target variable: predict resolution timeline\n",
    "    df_processed['target'] = df_processed['resolution_time'].astype(int)\n",
    "\n",
    "    # Select relevant features for modeling\n",
    "    feature_columns = [\n",
    "        'n_labels', 'n_answers', 'title_length',\n",
    "        'body_length', 'title_word_count', 'body_word_count',\n",
    "        'has_empty_body', 'has_code_blocks', 'code_block_count',\n",
    "        'url_count', 'has_urls', 'question_word_count',\n",
    "        'has_question_mark', 'includes_questions', 'n_urgent_words',\n",
    "        'has_exclamation', 'has_feature_label', 'has_doc_label', 'has_help_label', 'has_bug_label'\n",
    "    ]\n",
    "\n",
    "    # Prepare feature matrix and target\n",
    "    X = df_processed[feature_columns]\n",
    "    y = df_processed['target']\n",
    "\n",
    "    print(f\"Features selected: {len(feature_columns)}\")\n",
    "    print(f\"Target variable: resolution_time\")\n",
    "    print(f\"Target statistics:\")\n",
    "    print(f\"  Mean: {y.mean():.2f}\")\n",
    "    print(f\"  Median: {y.median():.2f}\")\n",
    "    print(f\"  Std: {y.std():.2f}\")\n",
    "    print(f\"  Min: {y.min()}\")\n",
    "    print(f\"  Max: {y.max()}\")\n",
    "    print(f\"Target distribution:\\n{y.value_counts().sort_index()}\")\n",
    "\n",
    "    # Handle any missing values\n",
    "    X = X.fillna(0)\n",
    "\n",
    "    return X, y, feature_columns\n",
    "\n",
    "X, y, feature_names = prepare_features(df)"
   ],
